#!/usr/bin/env php
<?php declare(strict_types = 1);

namespace ShipMonk\Modulint\Bin;

use Composer\Autoload\ClassLoader;
use ShipMonk\Modulint\Baseline\Baseline;
use ShipMonk\Modulint\Baseline\BaselineGenerator;
use ShipMonk\Modulint\Config\Configuration;
use ShipMonk\Modulint\Modulint;
use ShipMonk\Modulint\ResultFormatter\ConsoleResultFormatter;
use function array_slice;
use function file_put_contents;
use function fwrite;
use function getcwd;
use function getenv;
use function implode;
use function in_array;
use function is_array;
use function is_file;
use function is_string;
use const PHP_EOL;
use const STDERR;
use const STDOUT;

(static function (mixed $argvInput): void {
    $args = [];

    if (is_array($argvInput)) {
        foreach (array_slice($argvInput, 1) as $arg) {
            if (is_string($arg)) {
                $args[] = $arg;
            }
        }
    }

    $autoloadCandidates = [];

    if (isset($GLOBALS['_composer_autoload_path']) && is_string($GLOBALS['_composer_autoload_path'])) {
        $autoloadCandidates[] = $GLOBALS['_composer_autoload_path']; // set by composer's vendor/bin proxy, works even for symlinked path repositories
    }

    $autoloadCandidates[] = __DIR__ . '/../../../autoload.php'; // installed inside another project's vendor/
    $autoloadCandidates[] = __DIR__ . '/../vendor/autoload.php'; // modulint's own development

    $classLoader = null;

    foreach ($autoloadCandidates as $candidate) {
        if (is_file($candidate)) {
            /** @var ClassLoader $classLoader */
            $classLoader = require $candidate;
            break;
        }
    }

    if ($classLoader === null) {
        fwrite(STDERR, 'Could not locate Composer autoloader.' . PHP_EOL);
        exit(2);
    }

    $generateBaseline = in_array('--generate-baseline', $args, true);
    $unknownArgs = [];

    foreach ($args as $arg) {
        if ($arg !== '--generate-baseline') {
            $unknownArgs[] = $arg;
        }
    }

    if ($unknownArgs !== []) {
        fwrite(STDERR, 'Unknown arguments: ' . implode(' ', $unknownArgs) . PHP_EOL);
        fwrite(STDERR, 'Usage: modulint [--generate-baseline]' . PHP_EOL);
        exit(2);
    }

    $cwd = getcwd();

    if ($cwd === false) {
        fwrite(STDERR, 'Could not determine working directory.' . PHP_EOL);
        exit(2);
    }

    $configPath = $cwd . '/modulint.php';

    if (!is_file($configPath)) {
        fwrite(STDERR, "No modulint.php config found in {$cwd}." . PHP_EOL);
        exit(2);
    }

    $config = require $configPath;

    if (!$config instanceof Configuration) {
        fwrite(STDERR, 'modulint.php must return a ' . Configuration::class . ' instance.' . PHP_EOL);
        exit(2);
    }

    $enforcer = new Modulint();

    $result = $enforcer->enforce(
        $classLoader,
        $cwd,
        $config,
    );

    $baselinePath = "{$cwd}/{$config->getBaselineFile()}";

    if ($generateBaseline) {
        $content = (new BaselineGenerator())->generateFileContent($result);

        if (file_put_contents($baselinePath, $content) === false) {
            fwrite(STDERR, "Could not write baseline to {$baselinePath}." . PHP_EOL);
            exit(2);
        }

        fwrite(STDOUT, "Baseline generated at {$config->getBaselineFile()}." . PHP_EOL);
        exit(0);
    }

    if (is_file($baselinePath)) {
        $result = Baseline::fromFile($baselinePath)->apply($result);
    }

    $formatter = new ConsoleResultFormatter(STDOUT, getenv('NO_COLOR') !== false);
    $formatter->format($result);

    exit($result->isSuccessful() ? 0 : 1);
})($_SERVER['argv'] ?? null);
